diff --git a/e2e/skullzfyre.mjs b/e2e/skullzfyre.mjs
new file mode 100644
index 0000000..bfc2aca
--- /dev/null
+++ b/e2e/skullzfyre.mjs
@@ -0,0 +1,101 @@
+// node e2e/skullzfyre.mjs [baseUrl]
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import puppeteer from 'puppeteer';
+
+const base = process.argv[2] ?? 'http://localhost';
+const { users } = JSON.parse(readFileSync(new URL('./accounts.json', import.meta.url)));
+const gameId = 'skullzfyre';
+const catalogTitle = 'Эпичные схватки боевых магов: Битва на горе Черепламени';
+
+async function api(page, method, url, body) {
+  return page.evaluate(async (method, url, body) => {
+    const response = await fetch(url, {
+      method,
+      ...(body === undefined ? {} : {
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify(body),
+      }),
+    });
+    return { status: response.status, data: await response.json() };
+  }, method, url, body);
+}
+
+const browser = await puppeteer.launch();
+const players = [];
+let table;
+try {
+  for (const user of users.slice(0, 2)) {
+    const page = await (await browser.createBrowserContext()).newPage();
+    await page.goto(base + '/login', { waitUntil: 'domcontentloaded' });
+    const login = await api(page, 'POST', '/api/auth/login', user);
+    if (login.status >= 400) {
+      const register = await api(page, 'POST', '/api/auth/register', { ...user, agree: true });
+      assert.equal(register.status, 200);
+    }
+    players.push(page);
+  }
+
+  const [host] = players;
+  const catalog = await api(host, 'GET', '/api/games');
+  assert.equal(catalog.status, 200);
+  const game = catalog.data.find((entry) => entry.id === gameId);
+  assert.equal(game?.title, catalogTitle);
+  assert.equal(game.minPlayers, 2);
+  assert.equal(game.maxPlayers, 6);
+  const create = await api(host, 'POST', '/api/tables', { gameId, numPlayers: 2 });
+  assert.equal(create.status, 200);
+  table = create.data;
+
+  const frames = [];
+  for (const [seat, page] of players.entries()) {
+    await page.goto(base + '/t/' + table.id, { waitUntil: 'domcontentloaded' });
+    await page.waitForFrame((frame) => frame.url().startsWith(game.publicUrl + '/'));
+    const iframe = await page.waitForSelector('iframe.table-frame');
+    const frame = await iframe.contentFrame();
+    assert.ok(frame);
+    frames.push(frame);
+    const input = await frame.waitForSelector('.seat-name input');
+    assert.equal(await input.evaluate((element) => element.value), users[seat].name);
+    const claim = await frame.waitForSelector('.lobby-seat:nth-child(' + (seat + 1) + ') button:not(:disabled)');
+    await claim.click();
+    await frame.waitForFunction(() => document.querySelector('.lobby-seats')?.textContent.includes('Ваше место'));
+  }
+
+  const lobby = await api(host, 'GET', '/api/tables/' + table.id);
+  assert.deepEqual(lobby.data.seats.map((seat) => seat.name), users.slice(0, 2).map((user) => user.name));
+  assert.ok(lobby.data.seats.every((seat) => seat.user));
+  assert.equal(await frames[0].$eval('.invites', (element) => getComputedStyle(element).display), 'none');
+  const start = await frames[0].waitForSelector('.lobby-inner > button.primary:not(:disabled)');
+  await start.click();
+
+  for (const frame of frames) {
+    await frame.waitForSelector('.hand article');
+  }
+
+  const watcher = await (await browser.createBrowserContext()).newPage();
+  await watcher.goto(game.publicUrl + '/?embed=1#/m/' + table.matchId + '/watch');
+  await watcher.waitForSelector('.hand .empty-hand');
+  assert.equal((await watcher.$$('.hand article')).length, 0);
+  const spectator = await api(watcher, 'GET', '/api/' + table.matchId + '/view');
+  assert.equal(spectator.data.seat, null);
+  assert.deepEqual(spectator.data.game.hand, []);
+
+  let leave;
+  for (const player of players) {
+    leave = await api(player, 'POST', '/api/tables/' + table.id + '/leave', {});
+    assert.equal(leave.status, 200);
+  }
+  assert.equal(leave.data.closed, true);
+  const gone = await api(watcher, 'GET', '/games/' + gameId + '/' + table.matchId);
+  assert.equal(gone.status, 404);
+  table = null;
+  console.log('Каталог, игра во фрейме, приватность рук и закрытие стола проверены.');
+} finally {
+  if (table) {
+    for (const player of players) {
+      await api(player, 'POST', '/api/tables/' + table.id + '/leave', {}).catch(() => {});
+    }
+  }
+  await browser.close();
+}
